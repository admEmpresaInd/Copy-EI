425761760767564"><div class="c e_icone se_fonte material-icons"></div></div><div id="e_1700080_1_176425761760777506" class="gpc-e e_icone dd dm e_1700080_1_176425761760777506"><div class="c e_icone se_fonte material-icons"></div></div><div id="e_1700080_1_176425761760740261" class="gpc-e e_titulo dd dm e_1700080_1_176425761760740261"><div class="c e_titulo se_fonte"><h2><b><span>Veja o que </span><span>empresários</span></b><span> </span><b>de diferentes segmentos</b><b> dizem sobre nós.</b></h2></div></div><div id="e_1700080_1_20365" class="gpc-e e_botao dd dm e_1700080_1_20365 e_animacoes"><a data-animation-nome="fade" data-animation-duration="1000" data-animation-delay="0" data-animation-repeat="show" class="c borda_igual e_botao se_fonte sombra_3d link_interno" data-bloco="b_1700080_1_174180414267d1d26e5b3ff" data-bloco-mobile="b_1700080_1_174180414267d1d26e5b3ff">Quero Agendar Agora</a></div></div></div><div id="b_1700080_1_176421416375701189" class="gpc-b ll_background " ll_src="https://pages.greatpages.com.br/fss.fullsalessystem.com-obrigado2-playbook/1775078590/imagens/desktop/1700080_1_176421416375701189.webp" ll_src_mobile="https://pages.greatpages.com.br/fss.fullsalessystem.com-obrigado2-playbook/1775078590/imagens/mobile/1700080_1_176421416375701189.webp"><div class="gpc-b_sobreposicao"></div><div class="centralizar"><div id="e_1700080_1_176421416375719949" class="gpc-e e_titulo dd dm e_1700080_1_176421416375719949"><div class="c e_titulo se_fonte"><h4><span>Sobre a </span><b>Full Sale</b><b>s </b><b>System</b></h4></div></div><div id="e_1700080_1_176421416375770857" class="gpc-e e_texto dd dm e_1700080_1_176421416375770857"><div class="c e_texto se_fonte"><p><span>A "Full Sales System" (FSS) é uma consultoria especializada em equipes comerciais, que auxilia empresas a otimizarem o retorno sobre investimento (ROI) de seus funis e campanhas de vendas.</span></p><p><span><br></span></p><p><span>Fundada por Vinícius de Sá, Yuri Barbosa e Matheus Matuta, a FSS acumula mais de 8 anos de experiência em seus próprios empreendimentos, liderando equipes de vendas e implementando estratégias de marketing online. No primeiro ano de operação, a FSS alcançou um marco impressionante, atingindo um faturamento superior a 8 milhões de reais.</span></p><p><span><br></span></p><p><span>Após alcançarem um faturamento acumulado superior a 87 milhões de reais, Vinícius, Yuri e Matheus dedicam-se atualmente a assessorar empresários na seleção, capacitação e organização de equipes comerciais.</span></p></div></div><div id="e_1700080_1_176421416375745661" class="gpc-e e_botao dd dm e_1700080_1_176421416375745661 e_animacoes"><a data-animation-nome="fade" data-animation-duration="1000" data-animation-delay="0" data-animation-repeat="show" class="c borda_igual e_botao se_fonte sombra_3d link_interno" data-bloco="b_1700080_1_174180414267d1d26e5b3ff" data-bloco-mobile="b_1700080_1_174180414267d1d26e5b3ff">Quero Agendar Agora</a></div></div></div><div id="b_1700080_1_176904627054487936" class="gpc-b "><div class="gpc-b_sobreposicao"></div><div class="centralizar"><div id="e_1700080_1_176904627054484081" ll_src="https://pages.greatpages.com.br/fss.fullsalessystem.com-obrigado2-playbook/1775078590/imagens/desktop/1700080_1_176904627054484081.png" ll_src_mobile="https://pages.greatpages.com.br/fss.fullsalessystem.com-obrigado2-playbook/1775078590/imagens/desktop/1700080_1_176904627054484081.png" class="gpc-e e_imagem dd dm e_1700080_1_176904627054484081 se_imagem"><div class="c imagem e_imagem"></div></div><div id="e_1700080_1_176904627054465507" class="gpc-e e_texto dd dm e_1700080_1_176904627054465507"><div class="c e_texto se_fonte"><p><span>CNPJ 51.843.626/0001-09</span></p></div></div><div id="e_1700080_1_176904627054410765" class="gpc-e e_texto dd dm e_1700080_1_176904627054410765"><div class="c e_texto se_fonte"><p><span><a href="https://fss.fullsalessystem.com/termos-de-uso" class="link_externo" target="_blank"> Termos de Uso</a> |</span><